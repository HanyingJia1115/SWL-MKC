function [res] = myNMIACCwithmean(U,Y,numclass)

% stream = RandStream.getGlobalStream;
% reset(stream);

U_normalized = U ./ repmat(sqrt(sum(U.^2, 2)), 1, numclass);

maxIter = 50;
topNum = 20;

tmp1 = zeros(maxIter,1);
tmp2 = zeros(maxIter,1);
tmp3 = zeros(maxIter,1);

for iter = 1:maxIter
    indx = litekmeans(U_normalized, numclass, ...
        'MaxIter', 100, 'Replicates', 1);
    indx = indx(:);

    [newIndx] = bestMap(Y, indx);

    tmp1(iter) = mean(Y == newIndx);
    tmp2(iter) = MutualInfo(Y, newIndx);
    tmp3(iter) = purFuc(Y, newIndx);
end

% 分别取三个指标最高的20次
tmp1 = sort(tmp1, 'descend');
tmp2 = sort(tmp2, 'descend');
tmp3 = sort(tmp3, 'descend');

tmp1 = tmp1(1:topNum);
tmp2 = tmp2(1:topNum);
tmp3 = tmp3(1:topNum);

% 返回顺序：[ACC均值, NMI均值, Purity均值, ACC标准差, NMI标准差, Purity标准差]
res = [mean(tmp1), mean(tmp2), mean(tmp3), ...
       std(tmp1), std(tmp2), std(tmp3)];

end


